# API
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SESSION_HOURS=12
MAX_UPLOAD_MB=8

# En hosting con proxy (Render, Railway, Fly) ponlo en true
TRUST_PROXY=false

# PostgreSQL
# Opción A (recomendada en la nube): pega aqui la URL que te da
# Neon, Supabase, Railway o Render. Ejemplo:
#   postgresql://usuario:clave@host/neon_db?sslmode=require
DATABASE_URL=

# Opción B (solo para tu computador): variables separadas
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Runtrash
DB_USER=postgres
DB_PASSWORD=cambia_esta_clave
DB_SSL=false

# Opcional: publica el frontend desde el mismo servicio.
# Con esto basta un unico dominio y no hay que configurar CORS.
# Ruta ABSOLUTA a la carpeta que contiene los .html
FRONTEND_DIR=

# Administrador inicial (se crea/actualiza al iniciar la API)
# IMPORTANTE: 8 caracteres como mínimo, con letras y números
ADMIN_NAME=Administrador RunTrash
ADMIN_EMAIL=admin@runtrash.co
ADMIN_PASSWORD=cambia_esta_clave_de_administrador

# =========================================================
# INGRESO CON GOOGLE Y OUTLOOK (OAuth 2.0)
# =========================================================
# URL pública desde la que se abre la aplicación. Con ella se construye
# el redirect_uri que hay que registrar en cada proveedor:
#   Google:    {OAUTH_BASE_URL}/api/auth/oauth/google/callback
#   Microsoft: {OAUTH_BASE_URL}/api/auth/oauth/microsoft/callback
# En local suele ser http://localhost:3000.
OAUTH_BASE_URL=http://localhost:3000

# Google Cloud Console > Credenciales > ID de cliente OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra ID > Registros de aplicaciones > Certificados y secretos
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Modo demo local (solo para pruebas): los botones de Google y Outlook
# abren una pantalla del propio servidor donde se escribe un correo ya
# registrado en RunTrash. NO valida la identidad con Google ni con
# Microsoft. Por seguridad solo se activa si OAUTH_BASE_URL apunta a
# localhost. Nunca lo actives en producción.
# OAUTH_DEMO=1

# Permite el modo demo aunque OAUTH_BASE_URL no sea local. Solo para una
# demostración controlada: permite entrar con cualquier correo registrado
# sin validar al proveedor. Déjalo vacío en producción.
# OAUTH_DEMO_REMOTO=

# Secreto para firmar el state de OAuth. Si se deja vacío se genera uno
# aleatorio al arrancar (las autorizaciones en curso se invalidan al
# reiniciar). En producción define un valor largo y estable.
OAUTH_STATE_SECRET=

# Los usuarios deben existir previamente en RunTrash con el mismo correo.
# Los operarios no pueden entrar por OAuth: usan sus dos códigos.

# =========================================================
# ALMACENAMIENTO DE LAS FOTOS
# =========================================================
# local: las imágenes quedan en servidor/uploads.
#        OJO: en Render el disco es temporal, así que las fotos
#        se pierden en cada redespliegue.
# s3:    las imágenes van a Neon Object Storage (o cualquier
#        servicio compatible con S3) y NO se pierden nunca.
#
# Para usar Neon Object Storage:
#   1. En la consola de Neon abre tu proyecto
#   2. Ve a "Object storage" y crea un bucket llamado "uploads"
#   3. Abajo del todo, en "S3", genera unas claves de acceso
#   4. Pega abajo los valores y pon STORAGE_PROVIDER=s3
STORAGE_PROVIDER=local

# Solo si STORAGE_PROVIDER=s3
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=uploads
STORAGE_S3_REGION=us-east-2
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_FORCE_PATH_STYLE=true

# Recuperación de contraseña
# Minutos de validez del código de 6 dígitos
RECUPERACION_MINUTOS=20
# Intentos máximo antes de bloquear el código
RECUPERACION_INTENTOS=5
# true (solo demo local): el código se devuelve en la respuesta y se muestra
# en pantalla. Cualquiera que conozca un correo podría tomar la cuenta.
# false (recomendado y por defecto con NODE_ENV=production): el código nunca
# sale del servidor; debe enviarse por correo (integración pendiente).
EXPOSER_CODIGO_RECUPERACION=false

# Sembrar cuentas demo *@runtrash.test en producción. Déjalo en false:
# usan contraseñas conocidas. En local la migración 007 se aplica igual.
SEED_DEMO_ACCOUNTS=false
